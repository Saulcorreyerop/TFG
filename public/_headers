# Cabeceras de Netlify
#
# EL ORDEN IMPORTA, Y AL REVÉS DE LO QUE PARECE.
#
# Netlify aplica TODAS las reglas que coinciden con la ruta, y cuando dos
# declaran la misma cabecera, gana LA ÚLTIMA. No la más específica, y no
# la primera. Este archivo estuvo escrito al revés, con el bloque /* al
# final, y el resultado fue que su Cache-Control de max-age=0 pisaba la
# caché larga de /assets/*. Comprobado en el despliegue:
#
#   /assets/index-dVE9fZ90.js  ->  public,max-age=0,must-revalidate
#
# O sea que cada visitante se volvía a descargar los 640 KB de
# JavaScript en cada visita, que es exactamente el problema que se
# suponía arreglado.
#
# Por eso ahora va primero lo general y después lo específico.

# --- Base para todo, empezando por el HTML ---------------------------
# Sin caché: es lo que permite que un despliegue llegue a los usuarios
# que ya tienen la web abierta o guardada.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), microphone=(), camera=()

# --- Archivos que se pueden actualizar el mismo día ------------------
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/manifest.json
  Cache-Control: public, max-age=3600

# --- Iconos y logos: cambian muy poco, una semana --------------------
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/logo.png
  Cache-Control: public, max-age=604800

# La imagen de las tarjetas al compartir. WhatsApp y Twitter la cachean
# por su cuenta durante días, así que aquí también puede ir larga.
/og-carmeet.png
  Cache-Control: public, max-age=604800

# --- Temas de PrimeReact: una semana con revalidación -----------------
/themes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# --- Assets con hash en el nombre ------------------------------------
# Va el último a propósito: es la regla que tiene que ganar. El nombre
# del archivo cambia en cada build, así que un año es seguro.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
